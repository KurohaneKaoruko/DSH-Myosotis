{
  "name": "dsh-myosotis",
  "version": "0.3.0",
  "description": "DSH 的四层持久记忆 + 全文知识库 + 学习闭环：全局 / 项目 / 会话 / 深记忆，SQLite 文档索引，从纠错里修正权重，复盘过时与矛盾的记忆",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "context",
    "knowledge-base",
    "full-text-search",
    "self-improving",
    "sqlite"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "demo": "node tools/demo.mjs",
    "install:dsh": "node tools/install.mjs",
    "uninstall:dsh": "node tools/install.mjs --uninstall"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KurohaneKaoruko/DSH-Myosotis.git"
  },
  "homepage": "https://github.com/KurohaneKaoruko/DSH-Myosotis#readme",
  "bugs": {
    "url": "https://github.com/KurohaneKaoruko/DSH-Myosotis/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
